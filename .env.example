# ollama-vision-mcp — configuration
# All values shown are the defaults.

# OpenAI-compatible base URL of the local Ollama server.
VISION_MCP_BASE_URL=http://localhost:11434/v1

# Vision model to use. Pull it yourself:  ollama pull qwen2.5vl:7b
VISION_MCP_MODEL=qwen2.5vl:7b

# API key. Ollama ignores it, but keep a placeholder ("ollama") so the request
# is shaped like OpenAI. Leave empty to use "ollama".
VISION_MCP_API_KEY=

# Convention folder (relative to the project where the server is launched)
# where users drop screenshots for the agent to read.
VISION_MCP_INBOX=.ai/inbox

# Max output tokens for the vision model.
VISION_MCP_MAX_TOKENS=2048

# Auto-downscale images larger than 50 KB to 768px JPEG (faster local inference).
VISION_MCP_COMPRESS=1

# Thinking models (e.g. qwen3.5) burn output tokens on a reasoning trace and can
# return empty replies. 1 = keep thinking enabled, 0 (default) = send
# reasoning_effort=none to disable it.
VISION_MCP_THINK=0

# Compatibility aliases (optional)
# VISION_MODEL=qwen2.5vl:7b
# VISION_BASE_URL=http://localhost:11434/v1
